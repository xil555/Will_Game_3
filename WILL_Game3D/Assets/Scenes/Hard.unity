    triggerId: HardStrangeMan
  - displayText: Head down the road
    type: 2
    targetAmount: 1
    triggerId: HardNoticedTheft
  - displayText: Ask the grandma
    type: 3
    targetAmount: 3
    triggerId: HardGranny
  - displayText: Move the furniture
    type: 2
    targetAmount: 1
    triggerId: HardFurnitureSpot
  - displayText: Talk to the grandma again
    type: 3
    targetAmount: 1
    triggerId: HardGrannyNext
  - displayText: Check the next house
    type: 2
    targetAmount: 1
    triggerId: HardNextHouse
  - displayText: Check the gate
    type: 2
    targetAmount: 1
    triggerId: HardGate
  - displayText: Find another way around
    type: 2
    targetAmount: 1
    triggerId: HardHouse2Inside
  - displayText: Check on the woman
    type: 3
    targetAmount: 1
    triggerId: HardWoman
  - displayText: Get out of the house
    type: 2
    targetAmount: 1
    triggerId: HardHouse2Exit
  - displayText: Confront the strange man
    type: 3
    targetAmount: 1
    triggerId: HardStrangeManAgain
  - displayText: Find your Keys and Wallet
    type: 2
    targetAmount: 1
    triggerId: HardKeys
  - displayText: Get out
    type: 2
    targetAmount: 1
    triggerId: HardHouse3Exit
  - displayText: Go home
    type: 2
    targetAmount: 1
    triggerId: HardHome
